{
  // Tekan F5 di VS Code lalu pilih salah satu konfigurasi di bawah.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aplikasi - Chrome (web)",
      "type": "dart",
      "request": "launch",
      "cwd": "aplikasi",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Aplikasi - HP Android / perangkat terpilih",
      "type": "dart",
      "request": "launch",
      "cwd": "aplikasi",
      "program": "lib/main.dart"
    },
    {
      // Dipakai jika backend dijalankan dengan Docker (docker compose up -d)
      "name": "Aplikasi - Chrome (backend Docker)",
      "type": "dart",
      "request": "launch",
      "cwd": "aplikasi",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=API_URL=http://localhost:8080/kepegawaian-guru/backend/api"
      ]
    }
  ]
}
